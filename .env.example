# Copy this file to .env for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables (no quotes needed there).

# --- App ---
# Public address of the site; used for links in emails (e.g. https://evascarf.com).
# On Vercel it defaults to the project's production domain if left out.
BASE_URL=http://localhost:3000
# Long random string (keep it secret). Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
STORE_TIMEZONE=Africa/Cairo

# --- Database (Supabase) ---
# Leave empty locally to use the built-in local database (data/pglite).
# Supabase: Project → Connect → "Transaction pooler" connection string (port 6543),
# with your database password filled in.
DATABASE_URL=

# --- Product photos (Supabase Storage) ---
# Leave empty locally to keep photos in the uploads/ folder.
# Supabase: Project Settings → API → Project URL, and the "service_role" secret key (never share it).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

# --- Owner (dashboard) account, created by `npm run db:setup` / `npm run seed` ---
ADMIN_EMAIL=owner@example.com
# 8+ characters with upper and lower case, a number and a symbol
ADMIN_PASSWORD=
ADMIN_NAME=Eva Scarf

# --- Email (Brevo SMTP). Leave SMTP_HOST empty to save emails to ./outbox instead. ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Brevo: Settings → SMTP & API → SMTP tab. The login looks like 1234567@smtp-brevo.com
SMTP_USER=
# Brevo SMTP key (not your account password)
SMTP_PASS=
# Must be a sender you verified in Brevo (Senders, domains & dedicated IPs)
MAIL_FROM="Eva Scarf <your-verified-sender@example.com>"

# --- Optional ---
# PORT=3000
# DB_POOL_MAX=2
# AUTH_RATE_LIMIT=20
# Social links in the footer (defaults: the Eva Scarf Instagram and TikTok accounts)
# INSTAGRAM_URL=https://www.instagram.com/evasc_arf
# TIKTOK_URL=https://www.tiktok.com/@evascarf2
# Map picker addresses (OpenStreetMap Nominatim, called from the server). The defaults follow
# Nominatim's usage policy: at most 1 request per second, 30 lookups per minute per visitor.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEO_MIN_INTERVAL_MS=1000
# GEO_RATE_LIMIT=30
