{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "pdx1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{src/views/**,src/emails/**,src/locales/**,src/*.json,src/*.sql,public/brand/**,public/samples/**}"
    }
  }
}
