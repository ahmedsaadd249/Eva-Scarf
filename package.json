{
  "name": "eva-scarf",
  "version": "1.0.0",
  "private": true,
  "description": "Eva Scarf — online store for Sudanese tarhas",
  "type": "module",
  "main": "serve.mjs",
  "scripts": {
    "start": "node serve.mjs",
    "prestart": "npm run build:css",
    "build": "npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/tailwind.css -o public/css/tailwind.css --minify",
    "db:setup": "node scripts/db-setup.js",
    "seed": "node src/seed.js",
    "test": "node --test test/*.test.js",
    "e2e": "node scripts/e2e.mjs",
    "import-collection": "node scripts/import-collection.js",
    "test-email": "node scripts/test-email.js",
    "test:security": "node scripts/security-test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "owner:2fa-off": "node scripts/owner-2fa-off.js",
    "owner:set": "node scripts/set-owner.js",
    "pree2e": "npm run build:css",
    "build:worker": "node scripts/build-worker-files.mjs",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "puppeteer": "^25.14.0",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
