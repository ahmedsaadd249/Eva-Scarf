<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title><%= subject %></title>
</head>
<body style="margin:0;padding:0;background:#FAF5F1;-webkit-text-size-adjust:100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FAF5F1;">
    <tr>
      <td align="center" style="padding:28px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="<%= dir %>" style="max-width:560px;background:#FFFFFF;border-radius:18px;overflow:hidden;border:1px solid #EFE2DA;">
          <tr>
            <td align="center" style="background:#E8339A;padding:26px 24px 20px;">
              <img src="cid:<%= logoCid %>" width="48" alt="Eva Scarf" style="display:block;border:0;width:48px;height:auto;">
              <div style="font-family:Arial,Helvetica,sans-serif;color:#FFFFFF;letter-spacing:6px;font-size:12px;margin-top:10px;" dir="ltr">EVA SCARF</div>
            </td>
          </tr>
          <tr>
            <td style="padding:32px 28px 28px;font-family:<%- bodyFont %>;color:#2B1A24;font-size:15px;line-height:1.75;text-align:<%= align %>;">
              <%- body %>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:18px 28px 22px;background:#FBE3EF;font-family:<%- bodyFont %>;font-size:12px;line-height:1.6;color:#6E5862;">
              <%= t('email.footer') %><br>
              <a href="<%= baseUrl %>" style="color:#B4186F;text-decoration:underline;"><%= baseUrl.replace(/^https?:\/\//, '') %></a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
