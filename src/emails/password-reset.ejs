<h1 style="margin:0 0 14px;font-family:<%- displayFont %>;font-weight:normal;<%- displayStyle %>font-size:28px;line-height:1.3;color:#B4186F;"><%= t('email.reset.heading') %></h1>
<p style="margin:0 0 22px;"><%= t('email.reset.body', { name: user.full_name }) %></p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="border-radius:999px;background:#2B1A24;">
      <a href="<%= resetUrl %>" style="display:inline-block;padding:14px 28px;font-family:<%- bodyFont %>;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:999px;"><%= t('email.reset.cta') %></a>
    </td>
  </tr>
</table>
<p style="margin:22px 0 0;font-size:13px;color:#6E5862;"><%= t('email.reset.ignore') %></p>
