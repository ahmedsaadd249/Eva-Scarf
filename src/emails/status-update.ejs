<h1 style="margin:0 0 10px;font-family:<%- displayFont %>;font-weight:normal;<%- displayStyle %>font-size:28px;line-height:1.3;color:#B4186F;"><%= t('email.status.' + order.status + '.heading') %></h1>
<p style="margin:0 0 6px;"><%= t('email.status.' + order.status + '.body', { name: order.customer_name, amount: money(order.total) }) %></p>
<p style="margin:0 0 22px;font-size:14px;color:#6E5862;"><%= t('email.order.number') %> <strong style="color:#2B1A24;" dir="ltr"><%= order.order_no %></strong></p>

<% if (order.status === 'shipped') { %>
<%# Cash on delivery: say exactly how much to have ready for the courier. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FBE3EF;border-radius:14px;margin:0 0 22px;">
  <tr>
    <td style="padding:16px 18px;font-family:<%- bodyFont %>;color:#2B1A24;text-align:<%= align %>;">
      <div style="font-size:14px;color:#6E5862;"><%= t('email.status.amount_due') %></div>
      <div style="font-size:26px;line-height:1.3;font-weight:bold;color:#B4186F;"><%= money(order.total) %></div>
      <div style="font-size:13px;color:#6E5862;"><%= order.delivery_fee ? t('email.status.amount_includes_delivery', { fee: money(order.delivery_fee) }) : t('email.status.amount_free_delivery') %></div>
    </td>
  </tr>
</table>
<% } %>

<%- include('_items') %>

<%- include('_totals') %>

<% if (order.status === 'delivered' && order.rating_token && !order.rating_stars) { %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FBE3EF;border-radius:14px;margin:22px 0 24px;">
  <tr>
    <td align="center" style="padding:22px 16px;font-family:<%- bodyFont %>;color:#2B1A24;">
      <div style="font-family:<%- displayFont %>;<%- displayStyle %>font-size:22px;color:#B4186F;margin-bottom:6px;"><%= t('email.rate.heading') %></div>
      <div style="font-size:14px;margin-bottom:14px;"><%= t('email.rate.body') %></div>
      <div dir="ltr">
        <% for (let n = 1; n <= 5; n++) { %><a href="<%= baseUrl %>/rate/<%= order.rating_token %>?stars=<%= n %>" title="<%= n %>" style="display:inline-block;font-size:34px;line-height:1;color:#E8339A;text-decoration:none;padding:0 3px;">&#9733;</a><% } %>
      </div>
      <div style="font-size:12px;color:#6E5862;margin-top:8px;"><%= t('email.rate.hint') %></div>
    </td>
  </tr>
</table>
<% } else { %>
<div style="height:22px;"></div>
<% } %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="border-radius:999px;background:#2B1A24;">
      <a href="<%= baseUrl %>/account/orders/<%= order.order_no %>" style="display:inline-block;padding:14px 28px;font-family:<%- bodyFont %>;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:999px;"><%= t('email.view_order') %></a>
    </td>
  </tr>
</table>
