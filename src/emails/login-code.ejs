<%# A one-time code. `texts` picks the wording: email.code (customers), email.owner_code, email.owner_setup. %>
<h1 style="margin:0 0 14px;font-family:<%- displayFont %>;font-weight:normal;<%- displayStyle %>font-size:28px;line-height:1.3;color:#B4186F;"><%= t(texts + '.heading') %></h1>
<p style="margin:0 0 18px;"><%= t(texts + '.body') %></p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FBE3EF;border-radius:14px;margin:0 0 18px;">
  <tr>
    <td align="center" style="padding:20px 18px;">
      <div dir="ltr" style="font-family:'Courier New',Courier,monospace;font-size:36px;line-height:1.2;font-weight:bold;letter-spacing:10px;color:#2B1A24;"><%= code %></div>
      <div style="margin-top:6px;font-family:<%- bodyFont %>;font-size:13px;color:#6E5862;"><%= t(texts + '.valid') %></div>
    </td>
  </tr>
</table>
<p style="margin:0;font-size:13px;color:#6E5862;"><%= t(texts + '.ignore') %></p>
