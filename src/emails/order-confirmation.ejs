<h1 style="margin:0 0 10px;font-family:<%- displayFont %>;font-weight:normal;<%- displayStyle %>font-size:28px;line-height:1.3;color:#B4186F;"><%= t('email.order.heading', { name: order.customer_name }) %></h1>
<p style="margin:0 0 6px;"><%= t('email.order.intro') %></p>
<p style="margin:0 0 22px;font-size:14px;color:#6E5862;"><%= t('email.order.number') %> <strong style="color:#2B1A24;" dir="ltr"><%= order.order_no %></strong> &nbsp;|&nbsp; <%= formatDate(order.created_at) %></p>

<%- include('_items') %>

<%- include('_totals') %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FAF5F1;border-radius:12px;margin-bottom:24px;">
  <tr>
    <td style="padding:16px 18px;font-family:<%- bodyFont %>;font-size:14px;line-height:1.7;color:#2B1A24;text-align:<%= align %>;">
      <strong><%= t('email.order.deliver_to') %></strong><br>
      <%= order.customer_name %><br>
      <%= address(order) %><br>
      <span dir="ltr"><%= order.phone_primary %></span><% if (order.phone_secondary) { %> / <span dir="ltr"><%= order.phone_secondary %></span><% } %>
      <br><br>
      <strong><%= t('checkout.payment') %></strong><br>
      <%= t('email.order.cod', { total: money(order.total) }) %>
    </td>
  </tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="border-radius:999px;background:#2B1A24;">
      <a href="<%= baseUrl %>/account/orders/<%= order.order_no %>" style="display:inline-block;padding:14px 28px;font-family:<%- bodyFont %>;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:999px;"><%= t('email.view_order') %></a>
    </td>
  </tr>
</table>
