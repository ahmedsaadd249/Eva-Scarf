<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #F1E6DF;">
  <% order.items.forEach(function (item) { %>
  <tr>
    <td width="76" valign="top" style="padding:14px 0;width:76px;">
      <% if (item.cid) { %>
        <img src="cid:<%= item.cid %>" width="64" height="85" alt="<%= L(item, 'name') || t('product.this_tarha') %>" style="display:block;width:64px;height:85px;object-fit:cover;border-radius:10px;border:0;">
      <% } else { %>
        <div style="width:64px;height:85px;border-radius:10px;background:<%= item.swatch || '#E8339A' %>;"></div>
      <% } %>
    </td>
    <td valign="top" style="padding:14px 12px;font-family:<%- bodyFont %>;font-size:15px;color:#2B1A24;text-align:<%= align %>;">
      <div style="font-weight:bold;"><%= L(item, 'name') %></div>
      <div style="font-size:13px;color:#6E5862;"><%= t('email.qty_times', { qty: item.qty, price: money(item.final_unit_price) }) %><% if (item.discount_percent) { %> &nbsp;<span style="color:#B4186F;">-<%= item.discount_percent %>%</span><% } %></div>
    </td>
    <td valign="top" align="<%= alignEnd %>" style="padding:14px 0;font-family:<%- bodyFont %>;font-size:15px;color:#2B1A24;white-space:nowrap;" dir="<%= dir %>"><%= money(item.line_total) %></td>
  </tr>
  <% }) %>
</table>
