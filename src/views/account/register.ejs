<div class="mx-auto max-w-5xl px-4 pb-20 pt-6 md:px-6 md:pt-12">
  <div class="grid overflow-hidden rounded-card bg-white shadow-lift md:grid-cols-2" data-auth-card>
    <div class="flex flex-col justify-center p-6 md:p-10 lg:px-14 lg:py-14">
      <div class="mx-auto w-full max-w-sm">
        <img src="/brand/monogram-pink.png" alt="" class="h-14 w-auto">
        <h1 class="display mt-5 text-[34px] text-eva md:text-[40px]"><%= t('auth.register_title') %></h1>
        <p class="mt-1 text-[15px] text-ink-soft"><%= t('auth.register_sub') %></p>

        <form action="/account/register" method="post" class="mt-7 space-y-5" novalidate data-validate="register" data-once>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
          <%- include('../partials/field', { field: { name: 'full_name', label: t('auth.full_name'), value: values.full_name, error: errors.full_name, autocomplete: 'name', required: true } }) %>
          <%- include('../partials/field', { field: { name: 'email', label: t('auth.email'), type: 'email', value: values.email, error: errors.email, autocomplete: 'email', inputmode: 'email', fdir: 'ltr', required: true, placeholder: 'name@gmail.com' } }) %>
          <%- include('../partials/password-field', { field: { name: 'password', label: t('auth.password'), error: errors.password, checklist: true } }) %>
          <%- include('../partials/password-field', { field: { name: 'password_confirm', label: t('auth.password_confirm'), error: errors.password_confirm } }) %>
          <button class="press flex h-[52px] w-full items-center justify-center rounded-[10px] bg-ink text-white shadow-lift hover:bg-eva-deep active:bg-ink disabled:opacity-60"><span class="btn-label"><%= t('auth.create_account') %></span></button>
        </form>
        <p class="mt-6 text-center text-[14px] text-ink-soft"><%= t('auth.have_account') %> <a href="/account/login<%= typeof next !== 'undefined' && next ? '?next=' + encodeURIComponent(next) : '' %>" class="font-medium text-eva-deep underline-offset-4 hover:underline"><%= t('auth.login') %></a></p>
      </div>
    </div>
    <%- include('../partials/auth-characters', { acState: Object.keys(errors).length ? 'error' : 'idle' }) %>
  </div>
</div>
