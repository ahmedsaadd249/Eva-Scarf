<div class="mx-auto max-w-md px-4 pb-20 pt-10 md:pt-14">
  <div class="rounded-card bg-white p-6 shadow-lift md:p-8">
    <h1 class="display text-[32px] text-eva md:text-[38px]"><%= t('auth.forgot_title') %></h1>
    <% if (sent) { %>
      <div class="mt-5 flex items-start gap-3 rounded-xl bg-ok-soft px-4 py-3 text-[15px] text-ok" role="status">
        <%- include('../partials/icon', { name: 'mail', cls: 'mt-0.5 h-5 w-5 shrink-0' }) %>
        <p><%= t('auth.forgot_sent', { email: values.email }) %></p>
      </div>
      <a href="/account/login" class="mt-6 inline-block text-[14px] text-eva-deep underline-offset-4 hover:underline"><%= t('auth.back_to_login') %></a>
    <% } else { %>
      <p class="mt-1 text-[15px] text-ink-soft"><%= t('auth.forgot_sub') %></p>
      <form action="/account/forgot" method="post" class="mt-6 space-y-5" novalidate data-once>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/field', { field: { name: 'email', label: t('auth.email'), type: 'email', value: values.email, error: errors.email, autocomplete: 'email', inputmode: 'email', fdir: 'ltr', required: true } }) %>
        <button class="press flex h-[52px] w-full items-center justify-center rounded-[10px] bg-ink text-white shadow-lift hover:bg-eva-deep active:bg-ink disabled:opacity-60"><span class="btn-label"><%= t('auth.send_link') %></span></button>
      </form>
      <a href="/account/login" class="mt-6 inline-block text-[14px] text-eva-deep underline-offset-4 hover:underline"><%= t('auth.back_to_login') %></a>
    <% } %>
  </div>
</div>
