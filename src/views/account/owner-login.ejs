<div class="mx-auto max-w-md px-4 pb-20 pt-10 md:pt-16">
  <div class="rounded-card bg-white p-6 shadow-lift md:p-10">
    <img src="/brand/monogram-pink.png" alt="" class="h-12 w-auto">
    <h1 class="display mt-5 text-[30px] text-eva md:text-[34px]"><%= t('owner_login.title') %></h1>
    <p class="mt-1 text-[15px] text-ink-soft"><%= t('owner_login.sub') %></p>

    <% if (errors.form) { %>
      <p class="mt-5 flex items-start gap-2 rounded-xl bg-[#FBE7EA] px-4 py-3 text-[14px] text-[#8E1238]" role="alert"><%- include('../partials/icon', { name: 'alert', cls: 'mt-0.5 h-4 w-4 shrink-0' }) %><%= t(errors.form) %></p>
    <% } %>

    <form action="/admin/login" method="post" class="mt-6 space-y-5" data-once>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
      <%- include('../partials/field', { field: { name: 'email', label: t('auth.email'), type: 'email', value: values.email, autocomplete: 'username', inputmode: 'email', fdir: 'ltr', required: true } }) %>
      <%- include('../partials/password-field', { field: { name: 'password', label: t('auth.password'), autocomplete: 'current-password' } }) %>
      <button class="press flex h-[52px] w-full items-center justify-center rounded-[10px] bg-ink text-white shadow-lift hover:bg-eva-deep active:bg-ink disabled:opacity-60"><span class="btn-label"><%= t('auth.login') %></span></button>
    </form>
  </div>
</div>
