<%
  const pf = { error: null, autocomplete: 'new-password', checklist: false, ...field };
  const pid = 'f-' + pf.name;
  const rules = ['length', 'upper', 'lower', 'digit', 'symbol'];
  const pDescribed = [pf.checklist ? pid + '-rules' : '', pf.error ? pid + '-error' : ''].filter(Boolean).join(' ');
%>
<div data-field>
  <label for="<%= pid %>" class="mb-1.5 block text-[14px] font-medium text-ink"><%= pf.label %></label>
  <div class="relative" dir="ltr">
    <input id="<%= pid %>" name="<%= pf.name %>" type="password" autocomplete="<%= pf.autocomplete %>" required
      <% if (pf.checklist) { %>data-password-rules="<%= pid %>-rules"<% } %>
      <% if (pf.error) { %>aria-invalid="true"<% } %>
      <% if (pDescribed) { %>aria-describedby="<%= pDescribed %>"<% } %>
      class="h-12 w-full rounded-xl border bg-white pe-12 ps-4 text-[16px] text-ink outline-none transition-colors focus:border-eva-deep focus:ring-4 focus:ring-eva/10 <%= pf.error ? 'border-[#B3203A]' : 'border-line hover:border-ink/25' %>">
    <button type="button" data-toggle-password="<%= pid %>" class="press absolute end-1 top-1 grid h-10 w-10 place-items-center rounded-lg text-ink-soft hover:bg-eva-blush/60 hover:text-eva-deep active:bg-eva-blush" aria-label="<%= t('auth.show_password') %>" aria-pressed="false">
      <%- include('icon', { name: 'eye', cls: 'h-5 w-5' }) %>
    </button>
  </div>
  <% if (pf.checklist) { %>
    <ul id="<%= pid %>-rules" class="mt-2.5 grid grid-cols-1 gap-x-4 gap-y-1 text-[13px] text-ink-soft sm:grid-cols-2" aria-live="polite">
      <% rules.forEach(function (r) { %>
        <li class="rule flex items-center gap-2" data-rule="<%= r %>" data-ok="false">
          <span class="rule-dot grid h-3.5 w-3.5 place-items-center rounded-full border border-ink/30 text-white transition-colors"><%- include('icon', { name: 'check', cls: 'h-2.5 w-2.5', stroke: 3 }) %></span>
          <%= t('auth.rules.' + r) %>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <% if (pf.error) { %><p id="<%= pid %>-error" class="mt-1.5 flex items-center gap-1.5 text-[13px] text-[#B3203A]"><%- include('icon', { name: 'alert', cls: 'h-4 w-4 shrink-0' }) %><%= t(pf.error) %></p><% } %>
</div>
