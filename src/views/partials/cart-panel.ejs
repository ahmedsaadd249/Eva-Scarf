<%#
  The big cart panel's content (public/js/cart-panel.js loads it from /cart/panel into a panel that slides in
  over the page): the same lines, notices and totals as the cart page, computed by the server.
  Locals: lines, totals, notices, zone (from loadCart).
%>
<div class="flex items-center justify-between gap-3 border-b border-line px-5 py-4 md:px-7">
  <h2 id="cart-panel-title" class="display text-[28px] text-eva md:text-[32px]">
    <%= t('cart.title') %><% if (lines.length) { %> <span class="num text-[15px] font-normal text-ink-soft">(<%= totals.item_count %>)</span><% } %>
  </h2>
  <button type="button" data-cp-close class="press grid h-11 w-11 place-items-center rounded-full hover:bg-eva-blush/60 active:bg-eva-blush" aria-label="<%= t('nav.close') %>"><%- include('icon', { name: 'close', cls: 'h-5 w-5' }) %></button>
</div>

<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 md:px-7" data-cp-body>
  <div data-cp-message></div>
  <% if (notices.length) { %>
    <div class="mt-4 space-y-2 rounded-card border border-warn/25 bg-warn-soft px-4 py-3 text-[14px] text-warn" role="status">
      <% notices.forEach(function (n) { %><p class="flex gap-2"><%- include('icon', { name: 'info', cls: 'mt-0.5 h-4 w-4 shrink-0' }) %><%= t(n.key, { name: plabel(n.product), qty: n.qty }) %></p><% }) %>
    </div>
  <% } %>
  <% if (!lines.length) { %>
    <div class="py-16 text-center">
      <img src="/brand/monogram-pink.png" alt="" class="mx-auto h-20 w-auto opacity-40">
      <p class="mt-5 text-[17px]"><%= t('cart.empty') %></p>
      <p class="mt-1 text-[14px] text-ink-soft"><%= t('cart.empty_hint') %></p>
    </div>
  <% } else { %>
    <div class="mt-2"><%- include('cart-lines', { lines }) %></div>
  <% } %>
</div>

<div class="border-t border-line bg-white px-5 pb-5 pt-1 md:px-7 md:pb-6">
  <% if (lines.length) { %>
    <%- include('totals', { totals }) %>
    <%- include('cart-checkout', { zone }) %>
  <% } %>
  <button type="button" data-cp-close class="mt-3 block w-full rounded-[10px] py-2.5 text-center text-[14px] text-ink-soft underline-offset-4 hover:text-eva-deep hover:underline"><%= t('cart.continue') %></button>
</div>
