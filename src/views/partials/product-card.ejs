<% const pn = pname(p); %>
<article class="card group relative">
  <div class="card-media relative aspect-[3/4] overflow-hidden rounded-card bg-sand">
    <a href="/product/<%= p.slug %>" class="absolute inset-0" tabindex="-1" aria-hidden="true">
      <% if (p.image) { %>
        <img src="<%= p.image %>" alt="" loading="lazy" decoding="async" class="primary absolute inset-0 h-full w-full object-cover">
        <% if (p.image2) { %><img src="<%= p.image2 %>" alt="" loading="lazy" decoding="async" class="secondary absolute inset-0 h-full w-full object-cover opacity-0"><% } %>
      <% } else { %>
        <span class="absolute inset-0" style="background: <%= p.swatch %>"></span>
      <% } %>
      <span class="pointer-events-none absolute inset-0 bg-eva/[.04] mix-blend-multiply"></span>
      <span class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/30 to-transparent"></span>
    </a>

    <div class="pointer-events-none absolute start-2.5 top-2.5 flex flex-col items-start gap-1.5">
      <% if (!p.in_stock) { %>
        <span class="rounded-full bg-ink/85 px-3 py-1 text-[12px] text-white"><%= t('product.sold_out') %></span>
      <% } else if (p.discount_percent) { %>
        <span class="num rounded-full bg-eva px-3 py-1 text-[12px] font-medium text-white" dir="ltr">-<%= p.discount_percent %>%</span>
      <% } %>
      <% if (p.in_stock && p.stock <= 3) { %>
        <span class="rounded-full bg-white/90 px-3 py-1 text-[12px] text-eva-deep"><%= t('product.only_left', { n: p.stock }) %></span>
      <% } %>
    </div>

    <div class="absolute bottom-2.5 start-2.5 flex items-center gap-1.5">
      <form action="/cart/add" method="post" data-add-to-cart>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="product_id" value="<%= p.id %>">
        <button class="press grid h-10 w-10 place-items-center rounded-full bg-white/95 text-ink shadow-soft hover:bg-ink hover:text-white active:bg-eva-deep disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white/95 disabled:hover:text-ink" aria-label="<%= t('product.quick_add', { name: plabel(p) }) %>" <%= p.in_stock ? '' : 'disabled' %>>
          <%- include('icon', { name: 'bag-plus', cls: 'h-[19px] w-[19px]' }) %>
        </button>
      </form>
      <a href="/product/<%= p.slug %>" class="press grid h-10 w-10 place-items-center rounded-full bg-white/95 text-ink shadow-soft hover:bg-ink hover:text-white active:bg-eva-deep" aria-label="<%= t('product.view', { name: plabel(p) }) %>">
        <%- include('icon', { name: 'eye', cls: 'h-[19px] w-[19px]' }) %>
      </a>
    </div>
  </div>

  <div class="mt-3 px-0.5">
    <% if (pn) { %>
      <h3 class="display text-[19px] leading-snug text-eva-deep md:text-[21px]">
        <a href="/product/<%= p.slug %>" class="decoration-eva/40 underline-offset-4 hover:underline"><%= pn %></a>
      </h3>
    <% } %>
    <% if (p.rating_count) { %>
      <div class="mt-1"><%- include('stars', { value: p.avg_stars, count: p.rating_count, size: 'h-4 w-4' }) %></div>
    <% } %>
    <p class="mt-1 flex flex-wrap items-baseline gap-x-2 text-[15px]">
      <span class="num font-medium"><%= money(p.final_price) %></span>
      <% if (p.discount_percent) { %><s class="num text-[13px] text-ink-faint"><%= money(p.price) %></s><% } %>
    </p>
  </div>
</article>
