<%#
  Under the cart totals: the owner's note, or the delivery note and the "Complete order" button with the
  cash-on-delivery line. The cart page and the big cart panel. Locals: zone (the priced neighborhood or null;
  delivery is priced from the customer's neighborhood, which they choose at checkout).
%>
<% if (user && user.role === 'admin') { %>
  <p class="mt-6 flex items-start gap-2 rounded-xl bg-eva-mist px-4 py-3 text-[14px] text-eva-deep"><%- include('icon', { name: 'info', cls: 'mt-0.5 h-4 w-4 shrink-0' }) %><span><%= t('checkout.owner_account') %></span></p>
<% } else { %>
<% if (!zone) { %>
  <p class="mt-3 flex items-center gap-2 rounded-xl bg-eva-mist px-3 py-2.5 text-[13px] text-eva-deep" data-zone-note>
    <%- include('icon', { name: 'pin', cls: 'h-4 w-4 shrink-0' }) %><span class="flex-1"><%= t('cart.zone_at_checkout') %></span>
  </p>
<% } %>
<a href="/checkout" class="press mt-6 flex h-[54px] items-center justify-center rounded-[10px] bg-ink text-white shadow-lift hover:bg-eva-deep active:bg-ink"><span class="btn-label"><%= t('cart.checkout') %></span></a>
<p class="mt-3 flex items-center justify-center gap-2 text-[13px] text-ink-soft"><%- include('icon', { name: 'truck', cls: 'h-4 w-4' }) %><%= t('cart.cod_note') %></p>
<% } %>
