<%#
  Home hero: the newest tarhas as a photo collage that builds itself once when the page opens (after a
  Dribbble shot the owner chose), then turns by itself: the tarhas take turns in the big middle spot every
  few seconds (public/js/hero-slideshow.js; motion in site.css, "hero collage"). Tapping a photo puts that tarha
  in the cart and opens the big cart panel (cart-panel.js). Without the script every photo simply opens its tarha;
  for visitors who turn motion off it stays a still collage.
  Each card's place comes from its slot class: hc-centre (middle), hc-side-end (the next one), hc-side-start
  (the previous one).
  Locals: heroProducts (1–3 visible products with a photo, newest first).
%>
<% const slotClass = (i) => (i === 0 ? 'hc-centre' : i === 1 ? 'hc-side hc-side-end' : 'hc-side hc-side-start'); %>
<section aria-labelledby="hero-title" data-hero-collage class="hc hc-wait mx-auto max-w-6xl px-4 pt-4 md:px-6 md:pt-8">
  <div class="hc-panel relative overflow-hidden rounded-[28px] bg-sand px-4 pb-6 pt-8 md:px-10 md:pb-10 md:pt-10">
    <div class="hc-title relative z-10 mx-auto max-w-xl text-center">
      <h1 id="hero-title" class="display text-eva <%= lang === 'ar' ? 'text-[32px] md:text-[46px]' : 'text-[36px] md:text-[54px]' %>"><%= t('home.hero_title') %></h1>
      <p class="mx-auto mt-2 max-w-md text-[15px] text-ink-soft md:text-[16px]"><%= t('home.hero_sub') %></p>
    </div>

    <div class="hc-stage relative mt-6 flex items-end justify-center gap-2 md:mt-8 md:gap-5" data-hc-stage aria-roledescription="carousel" aria-label="<%= t('home.slideshow_label') %>">
      <% heroProducts.forEach(function (p, i) { %>
        <a href="/product/<%= p.slug %>" data-hc-card data-product-id="<%= p.id %>" class="hc-card <%= slotClass(i) %> relative block overflow-hidden rounded-card bg-white/40" aria-label="<%= t('product.view', { name: plabel(p) }) %>">
          <img src="<%= p.image %>" alt="" <%- i === 0 ? 'fetchpriority="high"' : '' %> decoding="async" class="aspect-[3/4] w-full object-cover">
        </a>
      <% }) %>
    </div>

    <div class="hc-cta mt-8 flex justify-center md:mt-10">
      <a href="/shop" class="press inline-flex h-[54px] items-center justify-center rounded-[10px] bg-ink px-10 text-white shadow-lift hover:bg-eva-deep active:bg-ink">
        <span class="btn-label"><%= t('home.hero_cta') %></span>
      </a>
    </div>
  </div>
</section>
