<%#
  Home hero: the newest tarhas as a photo collage that builds itself once when the page opens (after a
  Dribbble shot the owner chose): the panel fades in, the middle photo grows in, the side photos slide in
  from the edges, then the "Shop now" button. Motion in site.css ("hero collage"), started
  by app.js once the photos have loaded; visitors who turn motion off see it already built.
  Locals: heroProducts (1–3 visible products with a photo, newest first).
%>
<%
  const centre = heroProducts[0];
  const sides = heroProducts.slice(1, 3);
%>
<section aria-labelledby="hero-title" data-hero-collage class="hc hc-wait mx-auto max-w-6xl px-4 pt-4 md:px-6 md:pt-8">
  <div class="hc-panel relative overflow-hidden rounded-[28px] bg-sand px-4 pb-6 pt-8 md:px-10 md:pb-10 md:pt-10">
    <div class="hc-title relative z-10 mx-auto max-w-xl text-center">
      <h1 id="hero-title" class="display text-eva <%= lang === 'ar' ? 'text-[32px] md:text-[46px]' : 'text-[36px] md:text-[54px]' %>"><%= t('home.hero_title') %></h1>
      <p class="mx-auto mt-2 max-w-md text-[15px] text-ink-soft md:text-[16px]"><%= t('home.hero_sub') %></p>
    </div>

    <div class="relative mt-6 flex items-end justify-center gap-2 md:mt-8 md:gap-5">
      <% if (sides[0]) { %>
        <a href="/product/<%= sides[0].slug %>" class="hc-side hc-side-start relative block w-[27%] shrink-0 overflow-hidden rounded-card bg-white/40 md:w-[24%]" aria-label="<%= t('product.view', { name: plabel(sides[0]) }) %>">
          <img src="<%= sides[0].image %>" alt="" decoding="async" class="aspect-[3/4] w-full object-cover">
        </a>
      <% } %>
      <a href="/product/<%= centre.slug %>" class="hc-centre relative z-[1] block w-[46%] shrink-0 overflow-hidden rounded-card bg-white/40 shadow-lift md:w-[34%]" aria-label="<%= t('product.view', { name: plabel(centre) }) %>">
        <img src="<%= centre.image %>" alt="" fetchpriority="high" decoding="async" class="aspect-[3/4] w-full object-cover">
      </a>
      <% if (sides[1]) { %>
        <a href="/product/<%= sides[1].slug %>" class="hc-side hc-side-end relative block w-[27%] shrink-0 overflow-hidden rounded-card bg-white/40 md:w-[24%]" aria-label="<%= t('product.view', { name: plabel(sides[1]) }) %>">
          <img src="<%= sides[1].image %>" alt="" decoding="async" class="aspect-[3/4] w-full object-cover">
        </a>
      <% } %>
    </div>

    <div class="hc-cta mt-8 flex justify-center md:mt-10">
      <a href="/shop" class="press inline-flex h-[54px] items-center justify-center rounded-[10px] bg-ink px-10 text-white shadow-lift hover:bg-eva-deep active:bg-ink">
        <span class="btn-label"><%= t('home.hero_cta') %></span>
      </a>
    </div>
  </div>
</section>
