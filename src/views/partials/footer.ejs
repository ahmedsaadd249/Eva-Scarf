<%
  const socialLinks = [
    { href: social.instagram, icon: 'instagram', label: 'Instagram' },
    { href: social.tiktok, icon: 'tiktok', label: 'TikTok' },
  ].filter(function (s) { return s.href; });
%>
<%# Pink band (the brand pink): the brand and its line in the middle, then the copyright, links and social icons. %>
<footer class="mt-8 bg-eva pb-24 text-white md:pb-0">
  <div class="mx-auto max-w-6xl px-5 md:px-6">
    <div class="pt-12 text-center md:pt-14">
      <p class="text-[15px] font-semibold tracking-[0.18em]" dir="ltr" lang="en">EVA SCARF</p>
      <p class="mx-auto mt-4 max-w-md text-[16px] leading-relaxed"><%= t('footer.tagline') %></p>
    </div>
    <div class="mt-10 flex flex-col-reverse items-center gap-4 pb-8 text-[13px] md:flex-row md:justify-between md:pb-7">
      <p class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1">
        <span><%= t('footer.rights', { year: new Date().getFullYear() }) %></span>
        <a href="/privacy-policy" class="underline-offset-4 hover:underline active:opacity-70"><%= t('footer.privacy') %></a>
        <% if (storeEmail) { %><a href="mailto:<%= storeEmail %>" class="underline-offset-4 hover:underline active:opacity-70"><%= t('footer.contact') %></a><% } %>
      </p>
      <% if (socialLinks.length) { %>
        <ul class="flex items-center gap-3">
          <% socialLinks.forEach(function (s) { %>
            <li>
              <a href="<%= s.href %>" target="_blank" rel="noopener noreferrer" aria-label="<%= s.label %>" class="press grid h-10 w-10 place-items-center rounded-full hover:bg-white/20 active:bg-white/30">
                <%- include('icon', { name: s.icon, cls: 'h-6 w-6' }) %>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</footer>
