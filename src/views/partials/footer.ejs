<%
  const socialLinks = [
    { href: social.instagram, icon: 'instagram', label: 'Instagram' },
    { href: social.tiktok, icon: 'tiktok', label: 'TikTok' },
  ].filter(function (s) { return s.href; });
%>
<footer class="mt-8">
  <div class="grain overflow-hidden bg-eva pb-24 text-white md:pb-0">
    <div class="relative z-[2] mx-auto grid max-w-6xl gap-10 px-5 pt-14 md:grid-cols-[1.3fr_1fr_1fr] md:px-6 md:pt-16">
      <div>
        <img src="/brand/mark-white.png" alt="<%= t('meta.brand') %>" width="92" height="104" class="h-[104px] w-auto">
        <p class="display mt-6 max-w-sm text-[19px] font-medium leading-relaxed md:text-[21px]"><%= t('footer.tagline') %></p>
        <% if (socialLinks.length) { %>
          <h2 class="mt-7 text-[13px] text-white/75"><%= t('footer.follow') %></h2>
          <ul class="mt-3 flex flex-wrap gap-2.5">
            <% socialLinks.forEach(function (s) { %>
              <li>
                <a href="<%= s.href %>" target="_blank" rel="noopener noreferrer" class="press inline-flex h-11 items-center gap-2 rounded-full bg-white/15 pe-4 ps-3 text-[15px] hover:bg-white hover:text-eva-deep active:bg-white/80" dir="ltr">
                  <%- include('icon', { name: s.icon, cls: 'h-5 w-5' }) %><%= s.label %>
                </a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <div>
        <h2 class="text-[13px] text-white/75"><%= t('footer.shop') %></h2>
        <ul class="mt-3 space-y-2 text-[15px]">
          <li><a class="underline-offset-4 hover:underline active:opacity-70" href="/shop"><%= t('nav.shop_all') %></a></li>
        </ul>
      </div>
      <div>
        <h2 class="text-[13px] text-white/75"><%= t('footer.help') %></h2>
        <ul class="mt-3 space-y-2 text-[15px]">
          <% if (user && user.role === 'admin') { %>
            <li><a class="underline-offset-4 hover:underline active:opacity-70" href="/admin"><%= t('nav.admin') %></a></li>
          <% } else { %>
            <li><a class="underline-offset-4 hover:underline active:opacity-70" href="<%= user ? '/account/orders' : '/account/login' %>"><%= t('nav.orders') %></a></li>
            <li><a class="underline-offset-4 hover:underline active:opacity-70" href="<%= user ? '/account/profile' : '/account/register' %>"><%= user ? t('nav.profile') : t('nav.register') %></a></li>
          <% } %>
          <% if (storeEmail) { %>
            <li><a class="inline-flex items-center gap-2 underline-offset-4 hover:underline active:opacity-70" href="mailto:<%= storeEmail %>"><%- include('icon', { name: 'mail', cls: 'h-5 w-5' }) %><%= t('footer.contact') %></a></li>
          <% } %>
        </ul>
      </div>
    </div>
    <p class="relative z-[2] mx-auto mt-12 flex max-w-6xl flex-wrap gap-x-4 gap-y-1 px-5 pb-8 text-[13px] text-white/70 md:px-6">
      <span><%= t('footer.rights', { year: new Date().getFullYear() }) %></span>
      <a href="/privacy-policy" class="underline-offset-4 hover:text-white hover:underline active:opacity-70"><%= t('footer.privacy') %></a>
    </p>
  </div>
</footer>
