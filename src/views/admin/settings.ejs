<h1 class="display text-[34px] text-eva md:text-[42px]"><%= t('admin.settings') %></h1>

<div class="mt-6 grid gap-5 xl:grid-cols-2">
  <form action="/admin/settings" method="post" class="space-y-5 rounded-card bg-white p-5 shadow-soft md:p-6" novalidate data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 class="text-[16px] font-medium"><%= t('admin.store_settings') %></h2>
    <a href="/admin/delivery" class="press flex items-center gap-3 rounded-xl border border-line px-4 py-3 text-[14px] hover:border-eva-deep hover:text-eva-deep active:bg-eva-blush">
      <%- include('../partials/icon', { name: 'truck', cls: 'h-5 w-5 shrink-0 text-eva-deep' }) %>
      <span class="flex-1"><%= t('admin.delivery_moved') %></span>
      <%- include('../partials/icon', { name: 'chevron-right', cls: 'h-4 w-4 shrink-0 text-ink-faint', flipRtl: true }) %>
    </a>
    <%- include('../partials/field', { field: { name: 'store_email', label: t('admin.store_email'), type: 'email', value: values.store_email, error: errors.store_email, inputmode: 'email', fdir: 'ltr', hint: t('admin.store_email_hint') } }) %>
    <button class="press flex h-12 items-center justify-center rounded-[10px] bg-ink px-8 text-white hover:bg-eva-deep active:bg-ink disabled:opacity-60"><span class="btn-label"><%= t('admin.save') %></span></button>
  </form>

  <%# The owner's own password (the owner account has no customer profile page). %>
  <form action="/admin/settings/password" method="post" class="space-y-5 rounded-card bg-white p-5 shadow-soft md:p-6 xl:row-span-2" novalidate data-once aria-labelledby="password-title">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 id="password-title" class="text-[16px] font-medium"><%= t('profile.password_section') %></h2>
    <%- include('../partials/password-field', { field: { name: 'current_password', label: t('profile.current_password'), autocomplete: 'current-password', error: passwordErrors.current_password } }) %>
    <%- include('../partials/password-field', { field: { name: 'new_password', label: t('profile.new_password'), error: passwordErrors.new_password, checklist: true } }) %>
    <%- include('../partials/password-field', { field: { name: 'new_password_confirm', label: t('auth.password_confirm'), error: passwordErrors.new_password_confirm } }) %>
    <button class="press flex h-12 items-center justify-center rounded-[10px] border border-ink px-7 hover:bg-ink hover:text-white active:bg-eva-deep disabled:opacity-60"><span class="btn-label"><%= t('profile.change_password') %></span></button>
  </form>

  <%#
    The owner's second sign-in step: after the password, a code to this inbox. Switching it on, or changing
    the inbox, needs the current password and a code sent to the new inbox; switching off needs the password.
  %>
  <section id="otp" class="scroll-mt-24 rounded-card bg-white p-5 shadow-soft md:p-6" aria-labelledby="otp-title">
    <h2 id="otp-title" class="flex items-center gap-2 text-[16px] font-medium"><%- include('../partials/icon', { name: 'lock', cls: 'h-5 w-5 text-eva-deep' }) %><%= t('admin.otp_title') %></h2>
    <p class="mt-1 text-[14px] leading-relaxed text-ink-soft"><%= t('admin.otp_intro') %></p>
    <% if (otpEmail) { %>
      <p class="mt-4 flex items-start gap-2 rounded-xl bg-ok-soft px-4 py-3 text-[14px] text-ok" data-otp-status="on"><%- include('../partials/icon', { name: 'check', cls: 'mt-0.5 h-4 w-4 shrink-0' }) %><span><%= t('admin.otp_on') %> <span dir="ltr" class="font-medium"><%= otpEmail %></span></span></p>
    <% } else { %>
      <p class="mt-4 flex items-start gap-2 rounded-xl bg-warn-soft px-4 py-3 text-[14px] text-warn" data-otp-status="off"><%- include('../partials/icon', { name: 'info', cls: 'mt-0.5 h-4 w-4 shrink-0' }) %><span><%= t('admin.otp_off') %></span></p>
    <% } %>

    <% if (otpPending) { %>
      <p class="mt-5 rounded-xl bg-eva-mist px-4 py-3 text-[14px] leading-relaxed text-ink" data-code-sent>
        <%= t('code.sent_to') %> <strong dir="ltr" class="font-medium"><%= otpPending %></strong><br><%= t('admin.otp_confirm_note') %>
      </p>
      <form action="/admin/settings/otp/confirm" method="post" class="mt-5 space-y-5" novalidate data-otp-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/code-field', { codeError: otpSetupError, doneSub: t('admin.otp_done_sub') }) %>
        <button class="press flex h-12 w-full items-center justify-center rounded-[10px] bg-ink px-8 text-white hover:bg-eva-deep active:bg-ink disabled:opacity-60"><span class="btn-label"><%= t('code.verify') %></span></button>
      </form>
      <form action="/admin/settings/otp/cancel" method="post" class="mt-3" data-once>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="text-[14px] text-ink-soft underline-offset-4 hover:underline"><%= t('admin.otp_cancel') %></button>
      </form>
    <% } else { %>
      <form action="/admin/settings/otp" method="post" class="mt-5 space-y-5" novalidate data-once>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/field', { field: { name: 'otp_email', label: t('admin.otp_email'), type: 'email', value: otpValues.otp_email, error: otpErrors.otp_email, autocomplete: 'email', inputmode: 'email', fdir: 'ltr', required: true, hint: t('admin.otp_email_hint') } }) %>
        <%- include('../partials/password-field', { field: { name: 'otp_password', label: t('profile.current_password'), autocomplete: 'current-password', error: otpErrors.otp_password } }) %>
        <button class="press flex h-12 items-center justify-center rounded-[10px] bg-ink px-8 text-white hover:bg-eva-deep active:bg-ink disabled:opacity-60"><span class="btn-label"><%= t(otpEmail ? 'admin.otp_change' : 'admin.otp_send') %></span></button>
      </form>
      <% if (otpEmail) { %>
        <form action="/admin/settings/otp/off" method="post" class="mt-6 space-y-4 border-t border-line pt-5" novalidate data-once data-confirm="<%= t('admin.otp_off_confirm') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- include('../partials/password-field', { field: { name: 'off_password', label: t('profile.current_password'), autocomplete: 'current-password', error: otpErrors.off_password } }) %>
          <button class="press flex h-11 items-center justify-center rounded-[10px] border border-[#B3203A] px-6 text-[14px] text-[#8E1238] hover:bg-[#FBE7EA] active:bg-[#F6D3DA] disabled:opacity-60"><span class="btn-label"><%= t('admin.otp_turn_off') %></span></button>
        </form>
      <% } %>
    <% } %>
  </section>

  <section class="rounded-card bg-white p-5 shadow-soft md:p-6" aria-labelledby="email-title">
    <h2 id="email-title" class="text-[16px] font-medium"><%= t('admin.email_status') %></h2>
    <% if (smtpReady) { %>
      <p class="mt-3 flex items-start gap-2 rounded-xl bg-ok-soft px-4 py-3 text-[14px] text-ok"><%- include('../partials/icon', { name: 'check', cls: 'mt-0.5 h-4 w-4 shrink-0' }) %><span><%= t('admin.smtp_on') %> <span dir="ltr" class="font-medium"><%= mailFrom %></span></span></p>
    <% } else { %>
      <p class="mt-3 flex items-start gap-2 rounded-xl bg-warn-soft px-4 py-3 text-[14px] text-warn"><%- include('../partials/icon', { name: 'info', cls: 'mt-0.5 h-4 w-4 shrink-0' }) %><span><%= t('admin.smtp_off') %></span></p>
    <% } %>
    <h3 class="mt-5 text-[14px] font-medium text-ink-soft"><%= t('admin.recent_emails') %></h3>
    <% if (!emailLog.length) { %>
      <p class="mt-2 text-[14px] text-ink-faint"><%= t('admin.no_emails') %></p>
    <% } else { %>
      <ul class="mt-2 divide-y divide-line text-[13px]">
        <% emailLog.forEach(function (e) { %>
          <li class="flex items-center justify-between gap-3 py-2">
            <span class="min-w-0">
              <span class="block truncate" dir="ltr" style="text-align: start"><%= e.to_addr %></span>
              <%# An email type with no label (e.g. one the store no longer sends) shows as a plain "message". %>
              <% const typeKey = 'admin.email_types.' + e.type.replace(/^status-/, 'status_'); const typeLabel = t(typeKey); %>
              <span class="text-ink-soft"><%= typeLabel === typeKey ? t('admin.email_types.generic') : typeLabel %> · <%= formatDate(e.created_at) %></span>
            </span>
            <span class="shrink-0 rounded-full px-2 py-0.5 text-[12px] <%= e.status === 'sent' ? 'bg-ok-soft text-ok' : 'bg-[#FBE7EA] text-[#8E1238]' %>" title="<%= e.error || '' %>"><%= t('admin.email_' + e.status) %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
