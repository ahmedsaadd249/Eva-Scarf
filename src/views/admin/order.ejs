<%
  const addressRows = [
    ['profile.city', place(order).city], ['profile.village', place(order).village], ['profile.street', order.street],
    ['profile.building_no', order.building_no], ['profile.apartment_no', order.apartment_no],
  ];
  const sicons = { processing: 'box', shipped: 'truck', delivered: 'home' };
%>
<a href="/admin/orders" class="inline-flex items-center gap-1 text-[14px] text-ink-soft hover:text-eva-deep"><%- include('../partials/icon', { name: 'chevron-left', cls: 'h-4 w-4', flipRtl: true }) %><%= t('admin.orders') %></a>
<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
  <h1 class="num text-[28px] font-medium md:text-[32px]" dir="ltr"><%= order.order_no %></h1>
  <%- include('../partials/status-pill', { status: order.status }) %>
</div>
<p class="mt-1 text-[14px] text-ink-soft"><%= t('admin.placed_on', { date: formatDate(order.created_at) }) %></p>

<div class="mt-6 grid gap-5 xl:grid-cols-[1.5fr_1fr]">
  <div class="space-y-5">
    <section class="rounded-card bg-white p-5 shadow-soft" aria-labelledby="status-title">
      <h2 id="status-title" class="text-[16px] font-medium"><%= t('admin.change_status') %></h2>
      <p class="mt-1 text-[13px] text-ink-soft"><%= t('admin.status_email_note') %></p>
      <form action="/admin/orders/<%= order.id %>/status" method="post" class="mt-4 grid grid-cols-3 gap-2" data-once>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% ['processing', 'shipped', 'delivered'].forEach(function (s) { const on = order.status === s; %>
          <button name="status" value="<%= s %>" class="press flex flex-col items-center gap-1.5 rounded-xl border-2 px-2 py-3 text-[14px] <%= on ? 'border-eva-deep bg-eva-mist text-eva-deep' : 'border-line hover:border-ink/40 active:bg-eva-blush' %>" <%= on ? 'aria-pressed="true" disabled' : 'aria-pressed="false"' %>>
            <%- include('../partials/icon', { name: sicons[s], cls: 'h-6 w-6' }) %>
            <span class="font-medium"><%= t('status.' + s) %></span>
            <span class="text-[11px] <%= on ? 'text-eva-deep' : 'text-ink-faint' %>"><%= on ? t('admin.current') : t('admin.set_status') %></span>
          </button>
        <% }) %>
      </form>
      <ol class="mt-5 space-y-2 border-t border-line pt-4 text-[13px]">
        <% order.history.forEach(function (h) { %>
          <li class="flex justify-between gap-3"><span><%= t('status.' + h.status) %></span><span class="text-ink-soft"><%= formatDate(h.created_at) %></span></li>
        <% }) %>
      </ol>
    </section>

    <section class="rounded-card bg-white p-5 shadow-soft" aria-labelledby="items-title">
      <h2 id="items-title" class="text-[16px] font-medium"><%= t('admin.order_items') %></h2>
      <ul class="mt-2 divide-y divide-line">
        <% order.items.forEach(function (item) { %>
          <li class="flex items-center gap-3 py-3">
            <% if (item.image) { %><img src="<%= item.image %>" alt="" class="h-[84px] w-[63px] shrink-0 rounded-lg object-cover"><% } else { %><span class="h-[84px] w-[63px] shrink-0 rounded-lg" style="background: <%= item.swatch %>"></span><% } %>
            <div class="min-w-0 flex-1">
              <p class="text-[15px] font-medium <%= L(item, 'name') ? '' : 'font-normal text-ink-faint' %>"><%= L(item, 'name') || t('admin.unnamed_item') %></p>
              <p class="text-[13px] text-ink-soft"><%= t('email.qty_times', { qty: item.qty, price: money(item.final_unit_price) }) %></p>
              <% if (item.discount_percent) { %><p class="text-[12px] text-eva-deep"><%= t('admin.was_price', { price: money(item.unit_price), d: item.discount_percent }) %></p><% } %>
            </div>
            <p class="num text-[15px] font-medium"><%= money(item.line_total) %></p>
          </li>
        <% }) %>
      </ul>
      <div class="border-t border-line"><%- include('../partials/totals', { totals: order }) %></div>
      <p class="mt-3 flex items-center gap-2 text-[13px] text-ink-soft"><%- include('../partials/icon', { name: 'truck', cls: 'h-4 w-4' }) %><%= t('checkout.cod_desc', { total: money(order.total) }) %></p>
    </section>
  </div>

  <div class="space-y-5">
    <section class="rounded-card bg-white p-5 shadow-soft" aria-labelledby="cust-title">
      <h2 id="cust-title" class="text-[16px] font-medium"><%= t('admin.customer') %></h2>
      <p class="mt-3 text-[16px] font-medium"><%= order.customer_name %></p>
      <ul class="mt-2 space-y-2 text-[14px]">
        <li><a href="mailto:<%= order.customer_email %>" class="inline-flex items-center gap-2 text-eva-deep hover:underline"><%- include('../partials/icon', { name: 'mail', cls: 'h-4 w-4' }) %><span dir="ltr"><%= order.customer_email %></span></a></li>
        <li><a href="tel:<%= order.phone_primary %>" class="inline-flex items-center gap-2 text-eva-deep hover:underline"><%- include('../partials/icon', { name: 'phone', cls: 'h-4 w-4' }) %><span dir="ltr"><%= order.phone_primary %></span></a> <span class="text-[12px] text-ink-faint">(<%= t('admin.primary') %>)</span></li>
        <% if (order.phone_secondary) { %>
          <li><a href="tel:<%= order.phone_secondary %>" class="inline-flex items-center gap-2 text-eva-deep hover:underline"><%- include('../partials/icon', { name: 'phone', cls: 'h-4 w-4' }) %><span dir="ltr"><%= order.phone_secondary %></span></a> <span class="text-[12px] text-ink-faint">(<%= t('admin.secondary') %>)</span></li>
        <% } %>
      </ul>
    </section>

    <section class="rounded-card bg-white p-5 shadow-soft" aria-labelledby="addr-title">
      <h2 id="addr-title" class="flex items-center gap-2 text-[16px] font-medium"><%- include('../partials/icon', { name: 'pin', cls: 'h-5 w-5 text-eva-deep' }) %><%= t('admin.delivery_location') %></h2>
      <dl class="mt-3 divide-y divide-line text-[14px]">
        <% addressRows.forEach(function (row) { %>
          <div class="flex justify-between gap-4 py-2"><dt class="text-ink-soft"><%= t(row[0]) %></dt><dd class="text-end font-medium"><%= row[1] %></dd></div>
        <% }) %>
      </dl>
      <% if (order.location_lat != null && order.location_lng != null) { %>
        <%# The pin the customer confirmed on the profile map, for the courier. %>
        <div class="mt-3 rounded-xl bg-eva-mist p-3.5">
          <p class="text-[12px] text-ink-soft"><%= t('admin.map_location') %></p>
          <% if (order.location_label) { %><p class="mt-0.5 text-[14px] leading-relaxed"><%= order.location_label %></p><% } %>
          <a href="https://www.google.com/maps?q=<%= order.location_lat %>,<%= order.location_lng %>" target="_blank" rel="noopener noreferrer" data-maps-link
             class="press mt-2.5 inline-flex h-10 items-center gap-2 rounded-full bg-ink px-4 text-[14px] text-white hover:bg-eva-deep active:bg-ink">
            <%- include('../partials/icon', { name: 'pin', cls: 'h-4 w-4' }) %><%= t('admin.open_in_maps') %>
            <%- include('../partials/icon', { name: 'external', cls: 'h-3.5 w-3.5 opacity-70' }) %>
          </a>
        </div>
      <% } %>
    </section>

    <section class="rounded-card bg-white p-5 shadow-soft" aria-labelledby="rating-title">
      <h2 id="rating-title" class="text-[16px] font-medium"><%= t('admin.customer_rating') %></h2>
      <% if (order.rating_stars) { %>
        <div class="mt-3"><%- include('../partials/stars', { value: order.rating_stars, size: 'h-5 w-5' }) %></div>
        <% if (order.rating_comment) { %><p class="mt-2 text-[15px]">“<%= order.rating_comment %>”</p><% } %>
        <p class="mt-2 text-[12px] text-ink-faint"><%= formatDate(order.rated_at) %></p>
      <% } else { %>
        <p class="mt-2 text-[14px] text-ink-soft"><%= order.status === 'delivered' ? t('admin.rating_waiting') : t('admin.rating_after_delivery') %></p>
      <% } %>
    </section>
  </div>
</div>
