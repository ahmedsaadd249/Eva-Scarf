<%
  const views = [['all', t('shop.all')], ['active', t('admin.view_active')], ['hidden', t('admin.view_hidden')], ['archived', t('admin.view_archived')]];
  const returnTo = '/admin/products' + (view !== 'all' ? '?view=' + view : '');
  const input = 'num h-10 w-full rounded-lg border border-line bg-white px-2.5 text-[15px] outline-none hover:border-ink/25 focus:border-eva-deep focus:ring-2 focus:ring-eva/10';
%>
<div class="flex flex-wrap items-end justify-between gap-4">
  <h1 class="display text-[34px] text-eva md:text-[42px]"><%= t('admin.products') %></h1>
  <a href="/admin/products/new" class="press inline-flex h-11 items-center gap-2 rounded-[10px] bg-ink px-5 text-white shadow-lift hover:bg-eva-deep active:bg-ink"><%- include('../partials/icon', { name: 'plus', cls: 'h-5 w-5' }) %><span><%= t('admin.product_new') %></span></a>
</div>

<nav class="no-scrollbar mt-5 flex gap-2 overflow-x-auto" aria-label="<%= t('admin.filter_products') %>">
  <% views.forEach(function (v) { const on = view === v[0]; %>
    <a href="/admin/products<%= v[0] === 'all' ? '' : '?view=' + v[0] %>" class="press inline-flex h-10 shrink-0 items-center rounded-full border px-4 text-[14px] <%= on ? 'border-ink bg-ink text-white' : 'border-line bg-white hover:border-eva-deep hover:text-eva-deep active:bg-eva-blush' %>" <%- on ? 'aria-current="page"' : '' %>><%= v[1] %></a>
  <% }) %>
</nav>

<% if (view !== 'archived') { %>
<form id="bulk" action="/admin/products/bulk-discount" method="post" class="mt-5 rounded-card border border-eva/20 bg-eva-mist p-4" data-bulk-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <p class="flex items-center gap-2 text-[15px] font-medium text-eva-deep"><%- include('../partials/icon', { name: 'tag', cls: 'h-5 w-5' }) %><%= t('admin.bulk_title') %></p>
  <div class="mt-3 flex flex-wrap items-end gap-3">
    <div>
      <label for="bulk-scope" class="mb-1 block text-[13px] text-ink-soft"><%= t('admin.bulk_scope') %></label>
      <select id="bulk-scope" name="scope" class="h-10 rounded-lg border border-line bg-white px-3 text-[14px] outline-none focus:border-eva-deep" data-bulk-scope>
        <option value="selected"><%= t('admin.bulk_selected') %></option>
        <option value="all"><%= t('admin.bulk_all') %></option>
      </select>
    </div>
    <div class="w-28">
      <label for="bulk-percent" class="mb-1 block text-[13px] text-ink-soft"><%= t('admin.discount_percent') %></label>
      <input id="bulk-percent" name="percent" type="number" min="0" max="90" step="1" value="10" inputmode="numeric" class="<%= input %>" required>
    </div>
    <button class="press h-10 rounded-lg bg-eva-deep px-4 text-[14px] text-white hover:bg-ink active:bg-eva-deep"><%= t('admin.bulk_apply') %></button>
    <p class="w-full text-[12px] text-ink-soft"><%= t('admin.bulk_hint') %> <span data-selected-count class="num font-medium"></span></p>
  </div>
</form>
<% } %>

<% if (!products.length) { %>
  <p class="mt-6 rounded-card bg-white px-5 py-14 text-center text-ink-soft shadow-soft"><%= t('admin.no_products') %></p>
<% } else { %>
  <div class="mt-5 overflow-hidden rounded-card bg-white shadow-soft">
    <div class="hidden grid-cols-[28px_56px_1.4fr_110px_80px_80px_110px_64px_150px] items-center gap-3 border-b border-line bg-sand/50 px-4 py-3 text-[12px] text-ink-soft xl:grid">
      <span></span><span></span><span><%= t('admin.col_product') %></span><span><%= t('admin.price') %></span><span><%= t('admin.discount_percent') %></span><span><%= t('admin.stock') %></span><span><%= t('admin.final_price') %></span><span><%= t('admin.visible') %></span><span></span>
    </div>
    <ul class="divide-y divide-line">
      <% products.forEach(function (p) { const fid = 'q-' + p.id; %>
        <li class="grid grid-cols-[28px_56px_1fr] items-center gap-x-3 gap-y-3 px-4 py-4 xl:grid-cols-[28px_56px_1.4fr_110px_80px_80px_110px_64px_150px] <%= p.is_active ? '' : 'bg-sand/40' %>">
          <div>
            <% if (view !== 'archived') { %>
              <label class="grid h-7 w-7 cursor-pointer place-items-center"><span class="sr-only"><%= t('admin.select_product', { name: alabel(p) }) %></span><input type="checkbox" name="ids" value="<%= p.id %>" form="bulk" class="h-4 w-4 accent-[#B4186F]" data-bulk-check></label>
            <% } %>
          </div>
          <a href="/admin/products/<%= p.id %>/edit" class="block" tabindex="-1" aria-hidden="true">
            <% if (p.image) { %><img src="<%= p.image %>" alt="" class="h-[72px] w-14 rounded-lg object-cover"><% } else { %><span class="block h-[72px] w-14 rounded-lg" style="background: <%= p.swatch %>"></span><% } %>
          </a>
          <div class="min-w-0">
            <a href="/admin/products/<%= p.id %>/edit" class="block truncate text-[15px] hover:text-eva-deep <%= pname(p) ? 'font-medium' : 'text-ink-faint' %>"><%= alabel(p) %></a>
            <% if (p.is_featured) { %><p class="text-[13px] text-eva-deep"><%= t('admin.featured') %></p><% } %>
            <% if (p.stock === 0 && !p.is_archived) { %><p class="text-[12px] font-medium text-[#8E1238]"><%= t('product.sold_out') %></p><% } %>
          </div>

          <% if (view === 'archived') { %>
            <div class="col-span-3 flex items-center justify-between gap-3 xl:col-span-6 xl:col-start-4">
              <p class="text-[13px] text-ink-soft"><%= t('admin.archived_note', { n: p.times_ordered }) %></p>
              <form action="/admin/products/<%= p.id %>/restore" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="press inline-flex h-10 items-center gap-1.5 rounded-lg border border-line px-3 text-[14px] hover:border-eva-deep hover:text-eva-deep active:bg-eva-blush"><%- include('../partials/icon', { name: 'undo', cls: 'h-4 w-4' }) %><%= t('admin.restore') %></button>
              </form>
            </div>
          <% } else { %>
            <form id="<%= fid %>" action="/admin/products/<%= p.id %>/quick" method="post" class="hidden">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="return_to" value="<%= returnTo %>">
            </form>
            <div class="col-span-3 grid grid-cols-3 gap-2 xl:contents">
              <label class="block"><span class="mb-1 block text-[12px] text-ink-soft xl:sr-only"><%= t('admin.price') %></span><input form="<%= fid %>" name="price" value="<%= piastersToInput(p.price) %>" inputmode="decimal" class="<%= input %>" aria-label="<%= t('admin.price') %>"></label>
              <label class="block"><span class="mb-1 block text-[12px] text-ink-soft xl:sr-only"><%= t('admin.discount_percent') %></span><input form="<%= fid %>" name="discount_percent" type="number" min="0" max="90" value="<%= p.discount_percent %>" inputmode="numeric" class="<%= input %>"></label>
              <label class="block"><span class="mb-1 block text-[12px] text-ink-soft xl:sr-only"><%= t('admin.stock') %></span><input form="<%= fid %>" name="stock" type="number" min="0" value="<%= p.stock %>" inputmode="numeric" class="<%= input %> <%= p.stock <= 3 ? '!border-warn/50 !bg-warn-soft' : '' %>"></label>
            </div>
            <div class="col-span-3 flex items-center justify-between gap-3 xl:contents">
              <p class="text-[14px]">
                <span class="text-[12px] text-ink-soft xl:hidden"><%= t('admin.final_price') %>: </span>
                <span class="num font-medium"><%= money(p.final_price) %></span>
              </p>
              <label class="flex items-center gap-2 text-[13px]">
                <input form="<%= fid %>" type="checkbox" name="is_active" value="1" <%= p.is_active ? 'checked' : '' %> class="h-4 w-4 accent-[#B4186F]">
                <span class="xl:sr-only"><%= t('admin.visible') %></span>
              </label>
            </div>
            <div class="col-span-3 flex items-center justify-end gap-1.5 xl:col-span-1">
              <button form="<%= fid %>" class="press h-10 rounded-lg bg-ink px-4 text-[14px] text-white hover:bg-eva-deep active:bg-ink"><%= t('admin.save') %></button>
              <a href="/admin/products/<%= p.id %>/edit" class="press grid h-10 w-10 place-items-center rounded-lg border border-line hover:border-eva-deep hover:text-eva-deep active:bg-eva-blush" aria-label="<%= t('admin.edit_named', { name: alabel(p) }) %>"><%- include('../partials/icon', { name: 'edit', cls: 'h-[18px] w-[18px]' }) %></a>
              <form action="/admin/products/<%= p.id %>/delete" method="post" data-confirm="<%= p.times_ordered ? t('admin.confirm_archive', { name: alabel(p) }) : t('admin.confirm_delete', { name: alabel(p) }) %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="press grid h-10 w-10 place-items-center rounded-lg border border-line text-ink-soft hover:border-[#B3203A] hover:text-[#B3203A] active:bg-[#FBE7EA]" aria-label="<%= t('admin.delete_named', { name: alabel(p) }) %>"><%- include('../partials/icon', { name: p.times_ordered ? 'archive' : 'trash', cls: 'h-[18px] w-[18px]' }) %></button>
              </form>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>
