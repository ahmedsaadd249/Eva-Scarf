<div class="mx-auto max-w-lg px-4 pb-20 pt-10 md:pt-14">
  <div class="rounded-card bg-white p-6 shadow-lift md:p-8">
    <div class="flex -space-x-3 rtl:space-x-reverse">
      <% order.items.slice(0, 4).forEach(function (item) { %>
        <% if (item.image) { %><img src="<%= item.image %>" alt="" class="h-16 w-12 rounded-lg object-cover ring-2 ring-white"><% } else { %><span class="h-16 w-12 rounded-lg ring-2 ring-white" style="background: <%= item.swatch %>"></span><% } %>
      <% }) %>
    </div>

    <% if (order.rating_stars) { %>
      <h1 class="display mt-6 text-[34px] text-eva"><%= t('rate.thanks_title') %></h1>
      <p class="mt-2 text-ink-soft"><%= t('rate.thanks') %></p>
      <div class="mt-5"><%- include('../partials/stars', { value: order.rating_stars, size: 'h-6 w-6' }) %></div>
      <% if (order.rating_comment) { %><p class="display mt-3 text-[18px]">“<%= order.rating_comment %>”</p><% } %>
      <a href="/shop" class="press mt-8 inline-flex h-12 items-center rounded-[10px] bg-ink px-7 text-white hover:bg-eva-deep active:bg-ink"><span class="btn-label"><%= t('rate.shop_again') %></span></a>
    <% } else { %>
      <h1 class="display mt-6 text-[34px] text-eva"><%= t('rate.heading') %></h1>
      <p class="mt-2 text-ink-soft"><%= t('rate.sub', { no: order.order_no }) %></p>
      <form action="/rate/<%= order.rating_token %>" method="post" class="mt-6" data-once>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset>
          <legend class="mb-2 text-[14px] font-medium"><%= t('rate.stars_label') %></legend>
          <div class="star-input" dir="ltr">
            <% for (let n = 5; n >= 1; n--) { %>
              <input type="radio" id="star-<%= n %>" name="stars" value="<%= n %>" <%= preset === n ? 'checked' : '' %> required>
              <label for="star-<%= n %>" title="<%= t('rate.star_n', { n }) %>">
                <span class="sr-only"><%= t('rate.star_n', { n }) %></span>
                <%- include('../partials/icon', { name: 'star-solid', cls: 'h-10 w-10' }) %>
              </label>
            <% } %>
          </div>
          <% if (errors.stars) { %><p class="mt-2 text-[13px] text-[#B3203A]"><%= t(errors.stars) %></p><% } %>
        </fieldset>
        <label for="comment" class="mb-1.5 mt-6 block text-[14px] font-medium"><%= t('rate.comment') %> <span class="font-normal text-ink-faint">(<%= t('profile.optional') %>)</span></label>
        <textarea id="comment" name="comment" rows="4" maxlength="1000" placeholder="<%= t('rate.comment_placeholder') %>" class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[16px] outline-none transition-colors placeholder:text-ink-faint hover:border-ink/25 focus:border-eva-deep focus:ring-4 focus:ring-eva/10"><%= comment %></textarea>
        <button class="press mt-6 flex h-[52px] w-full items-center justify-center rounded-[10px] bg-ink text-white shadow-lift hover:bg-eva-deep active:bg-ink"><span class="btn-label"><%= t('rate.submit') %></span></button>
      </form>
    <% } %>
  </div>
</div>
