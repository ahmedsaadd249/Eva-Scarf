<% const pn = pname(product); const pics = images.length ? images : []; %>
<div class="mx-auto max-w-6xl md:grid md:grid-cols-[1.05fr_1fr] md:gap-12 md:px-6 md:pt-10 lg:gap-16">
  <%# Gallery: swipeable on phones, thumbnails on desktop %>
  <div class="md:sticky md:top-[100px] md:self-start">
    <div class="relative">
      <div data-gallery class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto md:rounded-card">
        <% if (pics.length) { %>
          <% pics.forEach(function (img, i) { %>
            <div class="relative aspect-[3/4] w-full shrink-0 snap-center bg-sand" id="img-<%= i %>">
              <img src="<%= img.path %>" alt="<%= i === 0 ? plabel(product) : '' %>" <%= i === 0 ? '' : 'loading=lazy' %> class="absolute inset-0 h-full w-full object-cover">
              <span class="pointer-events-none absolute inset-0 bg-eva/[.04] mix-blend-multiply"></span>
            </div>
          <% }) %>
        <% } else { %>
          <div class="aspect-[3/4] w-full shrink-0" style="background: <%= product.swatch %>"></div>
        <% } %>
      </div>
      <% if (pics.length > 1) { %>
        <div class="pointer-events-none absolute inset-x-0 bottom-4 flex justify-center gap-1.5 md:hidden" data-gallery-dots>
          <% pics.forEach(function (img, i) { %><span class="h-1.5 w-1.5 rounded-full bg-white/60 transition-transform duration-300 <%= i === 0 ? 'scale-150 !bg-white' : '' %>"></span><% }) %>
        </div>
      <% } %>
    </div>
    <% if (pics.length > 1) { %>
      <div class="mt-3 hidden gap-3 md:flex">
        <% pics.forEach(function (img, i) { %>
          <a href="#img-<%= i %>" data-gallery-thumb="<%= i %>" class="press block w-20 overflow-hidden rounded-[10px] border-2 <%= i === 0 ? 'border-eva-deep' : 'border-transparent hover:border-line' %>" aria-label="<%= t('product.image_n', { n: i + 1 }) %>">
            <img src="<%= img.path %>" alt="" loading="lazy" class="aspect-[3/4] w-full object-cover">
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="px-4 pb-16 pt-7 md:px-0 md:pt-2">
    <nav class="text-[13px] text-ink-soft" aria-label="<%= t('nav.breadcrumb') %>">
      <a href="/shop" class="hover:text-eva-deep"><%= t('nav.shop') %></a>
    </nav>
    <% if (pn) { %>
      <h1 class="display mt-3 text-[40px] text-eva md:text-[52px]"><%= pn %></h1>
    <% } else { %>
      <h1 class="sr-only"><%= plabel(product) %></h1>
    <% } %>
    <% if (product.rating_count) { %>
      <div class="mt-2"><%- include('../partials/stars', { value: product.avg_stars, count: product.rating_count, size: 'h-[18px] w-[18px]' }) %></div>
    <% } %>

    <p class="mt-4 flex flex-wrap items-baseline gap-x-3">
      <span class="num text-[26px] font-medium"><%= money(product.final_price) %></span>
      <% if (product.discount_percent) { %>
        <s class="num text-[17px] text-ink-faint"><%= money(product.price) %></s>
        <span class="num rounded-full bg-eva-blush px-2.5 py-0.5 text-[13px] font-medium text-eva-deep" dir="ltr">-<%= product.discount_percent %>%</span>
      <% } %>
    </p>

    <% if (product.in_stock) { %>
      <form id="add-to-cart" action="/cart/add" method="post" class="mt-6" data-add-to-cart>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <div class="flex gap-3">
          <div class="flex h-[54px] items-center rounded-[10px] border border-line bg-white" data-stepper>
            <button type="button" data-step="-1" class="press grid h-full w-12 place-items-center rounded-s-[10px] hover:bg-eva-blush/60 active:bg-eva-blush" aria-label="<%= t('product.decrease') %>"><%- include('../partials/icon', { name: 'minus', cls: 'h-4 w-4' }) %></button>
            <label for="qty" class="sr-only"><%= t('product.qty') %></label>
            <input id="qty" name="qty" type="number" inputmode="numeric" min="1" max="<%= Math.min(product.stock, 20) %>" value="1" class="num h-full w-12 border-0 bg-transparent text-center text-[17px] outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none">
            <button type="button" data-step="1" class="press grid h-full w-12 place-items-center rounded-e-[10px] hover:bg-eva-blush/60 active:bg-eva-blush" aria-label="<%= t('product.increase') %>"><%- include('../partials/icon', { name: 'plus', cls: 'h-4 w-4' }) %></button>
          </div>
          <button class="press flex h-[54px] flex-1 items-center justify-center gap-2 rounded-[10px] bg-ink px-6 text-white shadow-lift hover:bg-eva-deep active:bg-ink">
            <%- include('../partials/icon', { name: 'bag-plus', cls: 'h-5 w-5' }) %><span class="btn-label"><%= t('product.add_to_cart') %></span>
          </button>
        </div>
      </form>
      <p class="mt-3 text-[14px] <%= product.stock <= 3 ? 'text-eva-deep' : 'text-ink-soft' %>">
        <%= product.stock <= 3 ? t('product.only_left', { n: product.stock }) : t('product.in_stock') %>
      </p>
    <% } else { %>
      <div class="mt-6 rounded-[10px] border border-line bg-white px-5 py-4 text-[15px]">
        <p class="font-medium"><%= t('product.sold_out') %></p>
        <p class="mt-1 text-ink-soft"><%= t('product.sold_out_hint') %></p>
      </div>
    <% } %>

    <ul class="mt-6 space-y-2.5 text-[14px] text-ink-soft">
      <li class="flex items-center gap-2.5"><%- include('../partials/icon', { name: 'truck', cls: 'h-5 w-5 text-eva-deep' }) %><%= t('product.cod_note') %></li>
    </ul>

    <% const desc = L(product, 'description'); if (desc) { %>
      <div class="mt-8 border-t border-line pt-6">
        <h2 class="text-[15px] font-medium"><%= t('product.description') %></h2>
        <p class="mt-2 max-w-prose text-[16px] leading-[1.85] text-ink/85"><%= desc %></p>
      </div>
    <% } %>
  </div>
</div>

<% if (related.length) { %>
<section class="mx-auto max-w-6xl px-4 pb-16 pt-8 md:px-6 md:pt-16" aria-labelledby="related-title">
  <h2 id="related-title" class="display text-[30px] text-eva md:text-[40px]"><%= t('product.related') %></h2>
  <div class="mt-7 grid grid-cols-2 gap-x-3 gap-y-9 md:grid-cols-4 md:gap-x-5">
    <% related.forEach(function (p) { %><%- include('../partials/product-card', { p }) %><% }) %>
  </div>
</section>
<% } %>
