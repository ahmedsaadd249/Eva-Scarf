<div class="mx-auto max-w-6xl px-4 pb-20 md:px-6">
  <header class="pb-6 pt-10 md:pt-14">
    <h1 class="display text-[38px] text-eva md:text-[52px]"><%= t('cart.title') %></h1>
    <% if (lines.length) { %><p class="mt-1 text-[14px] text-ink-soft"><%= t('cart.items', { n: totals.item_count }) %></p><% } %>
  </header>

  <% if (notices.length) { %>
    <div class="mb-6 space-y-2 rounded-card border border-warn/25 bg-warn-soft px-4 py-3 text-[14px] text-warn" role="status">
      <% notices.forEach(function (n) { %><p class="flex gap-2"><%- include('../partials/icon', { name: 'info', cls: 'mt-0.5 h-4 w-4 shrink-0' }) %><%= t(n.key, { name: plabel(n.product), qty: n.qty }) %></p><% }) %>
    </div>
  <% } %>

  <% if (!lines.length) { %>
    <div class="mx-auto max-w-sm py-16 text-center">
      <img src="/brand/monogram-pink.png" alt="" class="mx-auto h-24 w-auto opacity-40">
      <p class="mt-6 text-[18px]"><%= t('cart.empty') %></p>
      <p class="mt-1 text-[15px] text-ink-soft"><%= t('cart.empty_hint') %></p>
      <a href="/shop" class="press mt-7 inline-flex h-[52px] items-center rounded-[10px] bg-ink px-8 text-white shadow-lift hover:bg-eva-deep active:bg-ink"><span class="btn-label"><%= t('cart.empty_cta') %></span></a>
    </div>
  <% } else { %>
    <div class="grid gap-8 md:grid-cols-[1fr_360px] md:items-start lg:gap-12">
      <%- include('../partials/cart-lines', { lines }) %>

      <aside class="rounded-card bg-white p-5 shadow-lift md:sticky md:top-[100px] md:p-6" aria-labelledby="summary-title">
        <h2 id="summary-title" class="text-[17px] font-medium"><%= t('cart.summary') %></h2>
        <%- include('../partials/totals', { totals }) %>
        <%- include('../partials/cart-checkout', { zone }) %>
        <a href="/shop" class="mt-4 block text-center text-[14px] text-ink-soft underline-offset-4 hover:text-eva-deep hover:underline"><%= t('cart.continue') %></a>
      </aside>
    </div>
  <% } %>
</div>
